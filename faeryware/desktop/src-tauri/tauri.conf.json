{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faeryware Resident",
  "version": "0.2.0",
  "identifier": "com.faeryware.desktop.resident",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Faeryware Resident",
      "width": 350,
      "height": 390,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "shadow": false,
      "visible": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "Tiny fae. Massive desktop impact."
  }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <application android:allowBackup="true" android:label="Faeryware" android:theme="@style/AppTheme" android:icon="@drawable/ic_faeryware">
        <!-- COLONY remains independently installable and deliberately does NOT claim HOME. HOUSE mode lives in the pinned iappyx chassis. -->
        <activity android:name=".FaerywareLauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FaerywareHauntConsoleActivity" android:exported="false" android:label="Ghost House" />

        <!-- Read-only HOUSE bridge. Runtime code also restricts callers to the pinned launcher package(s). -->
        <provider
            android:name=".FaerywareResidentProvider"
            android:authorities="com.faeryware.launcher.resident"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service android:name=".FaerywareGoblinOverlayService" android:exported="false" android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started visible draggable Digi Fae overlay sprites; no fullscreen interception or other-app input capture." />
        </service>
        <service android:name=".FaerywareAwarenessService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="Faeryware App Awareness">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/faeryware_accessibility_service" />
        </service>
        <service android:name=".FaerywareNotificationAwarenessService" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true" android:label="Faeryware Notification Awareness">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".FaerywareWallpaperService" android:exported="true" android:label="Faeryware Haunt" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/faeryware_wallpaper" />
        </service>
        <service android:name=".FaerywareTileService" android:exported="true" android:label="Haunt" android:icon="@drawable/ic_faeryware" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".FaerywareWidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/faeryware_widget_info" />
        </receiver>
        <receiver android:name=".FaerywareBootReceiver" android:enabled="true" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
